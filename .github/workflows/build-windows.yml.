name: Build Windows Executable

# Cuándo se ejecuta este workflow:
# - Manualmente, desde la pestaña "Actions" de GitHub (botón "Run workflow")
# - Automáticamente cada vez que subes cambios a la rama "main"
on:
  workflow_dispatch:
  push:
    branches: [ "main" ]

jobs:
  build-windows:
    # Le pedimos a GitHub una máquina virtual con Windows
    runs-on: windows-latest

    steps:
      # 1. Descarga el código del repositorio dentro de la VM
      - name: Clonar repositorio
        uses: actions/checkout@v4

      # 2. Instala Python en la VM de Windows
      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      # 3. Instala Flet (con soporte de escritorio) dentro de la VM
      - name: Instalar Flet
        run: pip install "flet[all]"

      # 4. Corre exactamente el comando que pide la tarea
      - name: Construir ejecutable con flet build windows
        run: flet build windows

      # 5. Sube el resultado como un archivo descargable ("artifact")
      - name: Subir ejecutable como artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-windows
          path: build/windows/
